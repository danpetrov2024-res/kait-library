<?xml version="1.0"?>
<ruleset name="KAIT Library">
    <description>
        PSR-12 coding standards for KAIT Library
    </description>

    <file>src</file>
    <file>public</file>
    <file>templates</file>
    <file>config</file>

    <arg name="extensions" value="php"/>

    <rule ref="PSR12">
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>
</ruleset>
